# Calico Cloud Credentials (REQUIRED)
# Used by install-calico-cloud.sh to connect your cluster to Calico Cloud
CALICO_CLOUD_KEY=your-cloud-key

# Azure Credentials (OPTIONAL for local dev)
# If you run 'az login' before running make commands, Terraform/scripts will use your logged-in user credentials automatically.
# Only uncomment these if you want to force specific Service Principal credentials.
# ARM_CLIENT_ID=your-client-id
# ARM_CLIENT_SECRET=your-client-secret
# ARM_SUBSCRIPTION_ID=your-subscription-id
# ARM_TENANT_ID=your-tenant-id

# Other Calico Credentials (OPTIONAL)
# CALICO_LICENSE_KEY=your-license-key
# CALICO_PULL_SECRET=your-pull-secret
